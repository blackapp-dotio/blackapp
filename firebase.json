{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/generateClientToken",
        "function": "generateClientToken"
      },
      {
        "source": "/createTransaction",
        "function": "createTransaction"
      },
      {
        "source": "/getCheckoutURL",
        "function": "getCheckoutURL"
      },
      {
        "source": "/checkout.html",
        "destination": "/checkout.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
